# Leave false until your credentials, release/source maps, clean baselines,
# budget, recovery, and controlled incident-to-PR checks are verified.
MONITOR_ENABLED=false

# Sentry internal integration: org:read, project:read, event:read.
# SENTRY_WEBHOOK_SECRET is the integration's Client Secret.
SENTRY_AUTH_TOKEN=
SENTRY_WEBHOOK_SECRET=

# Your own private GitHub App, installed only on registry repositories.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Use an RSA PEM with actual newlines or escaped \n sequences.
GITHUB_APP_PRIVATE_KEY=

# Generate separate random 32-byte values. Cron uses a bearer header, never a URL.
CRON_SECRET=
# Preserve this independent key across Cron rotation; changing it needs reconciliation.
STATE_SIGNING_SECRET=

# Optional dedicated read credential for deployment/log evidence.
VERCEL_READ_TOKEN=

# Only needed locally for the optional paid smoke; identify the AGENT project,
# not the monitored app. A fresh OIDC token must match both values.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Vercel supplies VERCEL_OIDC_TOKEN automatically to the deployment.
# For local smoke, link/pull the agent project's development environment.
# Keep pulled files and tokens local; never commit them.
